################################################################################
# DESeq2 analysis: differential transcript expression after nerve injury
#
# Summary:
#   This script performs count filtering, DESeq2 differential transcript expression
#   analysis, and exports normalized/transformed objects and contrast-level result
#   tables used for Figure 2 plotting.
#
# Outputs:
#   - Counts_filtered.tsv
#   - dds_full_object.rds
#   - vsd_full_object.rds
#   - C3_vs_C0_isoform_results.csv
#   - C7_vs_C0_isoform_results.csv
#   - C7_vs_C3_isoform_results.csv
#   - DESeq2_sample_metadata.csv
#
# Author: Wendy Dong
# Last updated: May 3, 2026
################################################################################

# ==============================================================================
# Setup
# ==============================================================================

suppressPackageStartupMessages({
  library(tidyverse)
  library(DESeq2)
})

# ---- User-defined paths ----
base_dir <- "/Users/wendydong/Documents/WUSM PhD/Long Read RNA Seq/Analysis_Long_Short_updated"
results_dir <- file.path(base_dir, "C3_C7_vs_C0_results_FINAL")

if (!dir.exists(results_dir)) {
  dir.create(results_dir, recursive = TRUE)
}

# ---- Input files ----
count_path <- file.path(results_dir, "all_transcripts_with_associated_genes_count.tsv")
stopifnot(file.exists(count_path))

# ---- Filtering and DESeq2 parameters ----
min_count <- 10
min_reps <- 2

# ==============================================================================
# Read annotated isoform count table
# ==============================================================================

counts_raw <- read_tsv(count_path, show_col_types = FALSE)

# Expected metadata columns before sample count columns:
#   transcript_id, transcript_symbol, associated_gene, gene_symbol, then samples
sample_cols <- colnames(counts_raw)[5:ncol(counts_raw)]

# ==============================================================================
# Filter lowly expressed isoforms
# ==============================================================================
# Retain isoforms with >= min_count counts in at least min_reps biological replicates of any condition.

counts_filtered <- counts_raw %>%
  mutate(
    C0_ge_min = rowSums(across(starts_with("C0_Control_"), ~ .x >= min_count)) >= min_reps,
    C3_ge_min = rowSums(across(starts_with("C3_Injured_"), ~ .x >= min_count)) >= min_reps,
    C7_ge_min = rowSums(across(starts_with("C7_Injured_"), ~ .x >= min_count)) >= min_reps,
    keep = C0_ge_min | C3_ge_min | C7_ge_min
  ) %>%
  filter(keep) %>%
  dplyr::select(-C0_ge_min, -C3_ge_min, -C7_ge_min, -keep)

write_tsv(counts_filtered, file.path(results_dir, "Counts_filtered.tsv"))

# ==============================================================================
# Prepare DESeq2 count matrix and sample metadata
# ==============================================================================

sample_cols <- colnames(counts_filtered)[5:ncol(counts_filtered)]

count_data <- counts_filtered %>%
  dplyr::select(all_of(sample_cols)) %>%
  mutate(across(everything(), round)) %>%
  as.data.frame()

rownames(count_data) <- counts_filtered$transcript_id

sample_info <- tibble(sample = sample_cols) %>%
  mutate(
    time_point = sub("^(C[0-9]+).*", "\\1", sample),
    treatment = case_when(
      str_detect(sample, "Injured") ~ "Injured",
      str_detect(sample, "Control") ~ "Control",
      TRUE ~ "Baseline"
    ),
    group = factor(
      paste0(time_point, "_", treatment),
      levels = c("C0_Control", "C3_Injured", "C7_Injured")
    )
  ) %>%
  as.data.frame()

rownames(sample_info) <- sample_info$sample

write_csv(sample_info, file.path(results_dir, "DESeq2_sample_metadata.csv"))

# ==============================================================================
# Run DESeq2
# ==============================================================================

dds <- DESeqDataSetFromMatrix(
  countData = count_data,
  colData = sample_info,
  design = ~ group
)

dds <- DESeq(dds)

saveRDS(dds, file.path(results_dir, "dds_full_object.rds"))

# Variance-stabilized object for PCA and heatmap plotting.
vsd <- varianceStabilizingTransformation(dds, blind = FALSE)
saveRDS(vsd, file.path(results_dir, "vsd_full_object.rds"))

# ==============================================================================
# Extract contrast-level DESeq2 results
# ==============================================================================

extract_deseq_results <- function(dds, numerator, denominator, annotation_tbl) {
  res <- results(
    dds,
    contrast = c("group", numerator, denominator),
    cooksCutoff = FALSE
  ) %>%
    as.data.frame()
  
  norm_counts <- counts(dds, normalized = TRUE)
  
  res %>%
    rownames_to_column("transcript_id") %>%
    mutate(
      transcript_symbol = annotation_tbl$transcript_symbol[match(transcript_id, annotation_tbl$transcript_id)],
      associated_gene = annotation_tbl$associated_gene[match(transcript_id, annotation_tbl$transcript_id)],
      gene_symbol = annotation_tbl$gene_symbol[match(transcript_id, annotation_tbl$transcript_id)],
      mean_num = rowMeans(norm_counts[, colData(dds)$group == numerator, drop = FALSE]),
      mean_den = rowMeans(norm_counts[, colData(dds)$group == denominator, drop = FALSE])
    ) %>%
    arrange(padj)
}

result_list <- list(
  C3_vs_C0 = extract_deseq_results(dds, "C3_Injured", "C0_Control", counts_filtered),
  C7_vs_C0 = extract_deseq_results(dds, "C7_Injured", "C0_Control", counts_filtered),
  C7_vs_C3 = extract_deseq_results(dds, "C7_Injured", "C3_Injured", counts_filtered)
)

walk2(
  result_list,
  names(result_list),
  ~ write_csv(.x, file.path(results_dir, paste0(.y, "_isoform_results.csv")))
)

# ==============================================================================
# Export normalized counts for source data / plotting
# ==============================================================================

normalized_counts <- counts(dds, normalized = TRUE) %>%
  as.data.frame() %>%
  rownames_to_column("transcript_id") %>%
  left_join(
    counts_filtered %>% dplyr::select(transcript_id, transcript_symbol, associated_gene, gene_symbol),
    by = "transcript_id"
  ) %>%
  relocate(transcript_symbol, associated_gene, gene_symbol, .after = transcript_id)

write_csv(normalized_counts, file.path(results_dir, "DESeq2_normalized_counts.csv"))
