  annotation_col = ann_col,
  main = "Top Differentially Expressed Isoforms",
  clustering_method = "ward.D2",
  angle_col = 315,
  silent = TRUE
)

save_panel(heat_plot$gtable, "FigS2_Heatmap.png", width_mm = 150, height_mm = 300, out_dir = supp_fig_dir)

