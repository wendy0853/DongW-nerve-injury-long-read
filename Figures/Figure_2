get_significant_det <- function(res, contrast_label, padj_cut = alpha, lfc = lfc_cut) {
  res %>%
    mutate(contrast = contrast_label) %>%
    filter(!is.na(padj), padj < padj_cut, abs(log2FoldChange) >= lfc) %>%
    transmute(
      contrast,
      contrast_pretty = recode_contrast(contrast),
      transcript_id,
      transcript_symbol,
      gene_symbol,
      log2FoldChange,
      padj,
      mean_den
    ) %>%
    distinct(transcript_symbol, contrast, .keep_all = TRUE)
}

