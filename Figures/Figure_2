count_det_direction <- function(res, comparison_label, padj_cut = alpha, lfc = lfc_cut) {
  res %>%
    filter(!is.na(padj), padj < padj_cut, abs(log2FoldChange) >= lfc) %>%
    mutate(
      direction = case_when(
        log2FoldChange > lfc ~ "Up",
        log2FoldChange < -lfc ~ "Down",
        TRUE ~ NA_character_
      )
    ) %>%
    filter(!is.na(direction)) %>%
    count(direction) %>%
    mutate(
      n_signed = if_else(direction == "Down", -n, n),
      comparison = factor(comparison_label, levels = comparison_levels)
    )
}

