# ---- ORF boundaries from SQANTI3 classifications ----
class_files <- list.files(class_dir, pattern = "classification_with_transcriptID.txt$", full.names = TRUE)
stopifnot(length(class_files) > 0)

orf_sqanti <- map_dfr(class_files, ~ read_tsv(.x, show_col_types = FALSE)) %>%
  transmute(
    transcript_id,
    strand,
    CDS_genomic_start = as.numeric(CDS_genomic_start),
    CDS_genomic_end = as.numeric(CDS_genomic_end),
    cds_len = abs(CDS_genomic_end - CDS_genomic_start)
  ) %>%
  group_by(transcript_id) %>%
  slice_max(cds_len, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(
    cds_start_tmp = pmin(CDS_genomic_start, CDS_genomic_end, na.rm = TRUE),
    cds_end_tmp = pmax(CDS_genomic_start, CDS_genomic_end, na.rm = TRUE),
    CDS_genomic_start = if_else(is.na(CDS_genomic_start) | is.na(CDS_genomic_end), NA_real_, cds_start_tmp),
    CDS_genomic_end = if_else(is.na(CDS_genomic_start) | is.na(CDS_genomic_end), NA_real_, cds_end_tmp)
  ) %>%
  select(transcript_id, CDS_genomic_start, CDS_genomic_end) %>%
  distinct()

# ---- Exon and CDS coordinates from renamed GTF files ----
gtf_files <- list.files(gtf_dir, pattern = "\\.gtf$", full.names = TRUE)
stopifnot(length(gtf_files) > 0)

gtf_all <- map_dfr(gtf_files, function(f) {
  import(f) %>%
    as.data.frame() %>%
    mutate(sample = str_remove(basename(f), "\\.gtf$"))
})

cds_from_gtf <- gtf_all %>%
  filter(type == "CDS") %>%
  group_by(transcript_id) %>%
  summarise(
    CDS_genomic_start = min(start),
    CDS_genomic_end = max(end),
    .groups = "drop"
  )

orf_combined <- full_join(orf_sqanti, cds_from_gtf, by = "transcript_id") %>%
  transmute(
    transcript_id,
    CDS_genomic_start = coalesce(CDS_genomic_start.x, CDS_genomic_start.y),
    CDS_genomic_end = coalesce(CDS_genomic_end.x, CDS_genomic_end.y)
  )

gtf_exons <- gtf_all %>%
  filter(type == "exon") %>%
  left_join(orf_combined, by = "transcript_id") %>%
  mutate(
    region_type = case_when(
      is.na(CDS_genomic_start) | is.na(CDS_genomic_end) ~ "UTR",
      strand == "+" & end < CDS_genomic_start ~ "5UTR",
      strand == "+" & start > CDS_genomic_end ~ "3UTR",
      strand == "+" & start >= CDS_genomic_start & end <= CDS_genomic_end ~ "CDS",
      strand == "-" & start > CDS_genomic_end ~ "5UTR",
      strand == "-" & end < CDS_genomic_start ~ "3UTR",
      strand == "-" & start >= CDS_genomic_start & end <= CDS_genomic_end ~ "CDS",
      TRUE ~ "Mixed"
    )
  )

# ---- Per-transcript regional exon lengths ----
# Mixed exons are not split here; they are excluded from region-specific length bins.
# For publication, keep this explicit in the methods or split mixed exons upstream.
tx_region_len <- gtf_exons %>%
  mutate(exon_len = pmax(0, end - start + 1)) %>%
  mutate(
    region_bin = case_when(
      region_type == "5UTR" ~ "UTR5_len",
      region_type == "3UTR" ~ "UTR3_len",
      region_type == "CDS" ~ "CDS_len",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(region_bin)) %>%
  group_by(transcript_id, region_bin) %>%
  summarise(len = sum(exon_len, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = region_bin, values_from = len, values_fill = 0) %>%
  mutate(
    UTR5_len = if (!"UTR5_len" %in% names(.)) 0 else UTR5_len,
    CDS_len = if (!"CDS_len" %in% names(.)) 0 else CDS_len,
    UTR3_len = if (!"UTR3_len" %in% names(.)) 0 else UTR3_len
  ) %>%
  transmute(
    tx_id = transcript_id,
    UTR5_len,
    CDS_len,
    UTR3_len
  )

# ---- Identify dominant baseline isoform for each gene ----
counts_for_structure <- counts_filtered %>%
  rename(tx_id = transcript_symbol)

count_long <- counts_for_structure %>%
  select(tx_id, starts_with("C0_"), starts_with("C3_"), starts_with("C7_")) %>%
  pivot_longer(-tx_id, names_to = "sample", values_to = "count") %>%
  mutate(
    sample = standardize_sample_name(sample),
    condition = str_extract(sample, "^C\\d+")
  ) %>%
  left_join(counts_for_structure %>% distinct(tx_id, gene_symbol), by = "tx_id")

baseline_tbl_structure <- counts_for_structure %>%
  mutate(
    n_C0_ge_min = rowSums(across(all_of(C0_cols), ~ .x >= min_count), na.rm = TRUE),
    iso_expressed_baseline = n_C0_ge_min >= min_reps
  ) %>%
  group_by(gene_symbol) %>%
  mutate(gene_has_any_baseline_isoform = any(iso_expressed_baseline)) %>%
  ungroup() %>%
  mutate(
    baseline_status = case_when(
      iso_expressed_baseline ~ "Expressed at Baseline",
      !iso_expressed_baseline & !gene_has_any_baseline_isoform ~ "Emerged: Activation",
      !iso_expressed_baseline & gene_has_any_baseline_isoform ~ "Emerged: Remodeling",
      TRUE ~ NA_character_
    )
  ) %>%
  select(tx_id, gene_symbol, n_C0_ge_min, iso_expressed_baseline, gene_has_any_baseline_isoform, baseline_status) %>%
  distinct(tx_id, .keep_all = TRUE)

c0_dominant_isoform <- count_long %>%
  filter(condition == "C0", !is.na(gene_symbol)) %>%
  group_by(gene_symbol, tx_id) %>%
  summarise(mean_count_C0 = mean(count, na.rm = TRUE), .groups = "drop") %>%
  left_join(
    baseline_tbl_structure %>% distinct(tx_id, gene_symbol, iso_expressed_baseline),
    by = c("tx_id", "gene_symbol")
  ) %>%
  filter(iso_expressed_baseline) %>%
  group_by(gene_symbol) %>%
  slice_max(mean_count_C0, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  rename(ref_tx = tx_id)

# ---- Compare emerged-remodeling DETs to dominant baseline isoform ----
isoform_structure_df <- det_emerge_remodel %>%
  mutate(tx_id = transcript_symbol) %>%
  left_join(
    baseline_tbl_structure %>% select(tx_id, gene_symbol, iso_expressed_baseline, baseline_status),
    by = c("tx_id", "gene_symbol")
  ) %>%
  left_join(c0_dominant_isoform, by = "gene_symbol") %>%
  left_join(tx_region_len, by = "tx_id") %>%
  rename(UTR5 = UTR5_len, CDS = CDS_len, UTR3 = UTR3_len) %>%
  left_join(
    tx_region_len %>%
      rename(ref_tx = tx_id, ref_UTR5 = UTR5_len, ref_CDS = CDS_len, ref_UTR3 = UTR3_len),
    by = "ref_tx"
  ) %>%
  mutate(
    UTR5 = coalesce(UTR5, 0),
    CDS = coalesce(CDS, 0),
    UTR3 = coalesce(UTR3, 0),
    ref_UTR5 = coalesce(ref_UTR5, 0),
    ref_CDS = coalesce(ref_CDS, 0),
    ref_UTR3 = coalesce(ref_UTR3, 0),
    d_UTR5 = UTR5 - ref_UTR5,
    d_CDS = CDS - ref_CDS,
    d_UTR3 = UTR3 - ref_UTR3,
    flag_UTR = abs(d_UTR5) >= region_length_tolerance | abs(d_UTR3) >= region_length_tolerance,
    flag_CDS = abs(d_CDS) >= region_length_tolerance,
    remodel_class = case_when(
      flag_UTR & !flag_CDS ~ "UTR only",
      !flag_UTR & flag_CDS ~ "CDS only",
      flag_UTR & flag_CDS ~ "UTR + CDS",
      !flag_UTR & !flag_CDS ~ "Non-coding",
      TRUE ~ "No length change"
    )
  )

write_csv(isoform_structure_df, file.path(results_dir, "Fig2E_UTR_CDS_remodeling_annotated_source_data.csv"))

structure_qc <- isoform_structure_df %>%
  summarise(
    n = n(),
    n_missing_ref = sum(is.na(ref_tx)),
    frac_missing_ref = n_missing_ref / n
  )

write_csv(structure_qc, file.path(results_dir, "Fig2E_UTR_CDS_remodeling_QC.csv"))

remodel_plot_df <- isoform_structure_df %>%
